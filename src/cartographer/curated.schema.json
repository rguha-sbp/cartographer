{
  "$defs": {
    "evidence": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "fact": {
              "type": "string"
            }
          },
          "required": [
            "fact"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "contains": {
              "minLength": 1,
              "type": "string"
            },
            "file": {
              "type": "string"
            },
            "line": {
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "file",
            "line",
            "contains"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "stated": {
              "description": "A short paraphrase of what the engineer said. Only for source description.",
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "stated"
          ],
          "type": "object"
        }
      ]
    }
  },
  "additionalProperties": false,
  "properties": {
    "assumptions": {
      "description": "Best guesses for what the engineer did not say. Never drawn. about is a node or external id, or an edge written as src->dst with the ids of its two ends, for example fn->psp.",
      "items": {
        "additionalProperties": false,
        "properties": {
          "about": {
            "type": "string"
          },
          "guess": {
            "type": "string"
          }
        },
        "required": [
          "about",
          "guess"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "drawio_sha256": {
      "description": "Written by cartographer build; keep it unchanged.",
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "edges": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "dashed": {
            "type": "boolean"
          },
          "dst": {
            "type": "string"
          },
          "evidence": {
            "items": {
              "$ref": "#/$defs/evidence"
            },
            "minItems": 1,
            "type": "array"
          },
          "flow": {
            "enum": [
              "web",
              "trigger",
              "runtime",
              "credential",
              "data"
            ]
          },
          "label": {
            "description": "A specific verb plus protocol, at most 28 characters",
            "maxLength": 28,
            "type": "string"
          },
          "src": {
            "type": "string"
          }
        },
        "required": [
          "src",
          "dst",
          "label",
          "flow",
          "dashed",
          "evidence"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "externals": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "attributes": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Attributes of that Terraform resource type that choose among its icons, for described nodes and managed-service externals.",
            "type": "object"
          },
          "evidence": {
            "items": {
              "$ref": "#/$defs/evidence"
            },
            "type": "array"
          },
          "icon": {
            "description": "Qualified icon name such as brand:github or aws:bedrock, or none. Find names with `cartographer icons`.",
            "oneOf": [
              {
                "pattern": "^[a-z]+:[a-z0-9_]+$",
                "type": "string"
              },
              {
                "const": "none"
              }
            ]
          },
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "tf_type": {
            "description": "A Terraform resource type the catalog resolves the icon from, for described nodes and managed-service externals.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "label",
          "evidence"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "format": {
      "const": 2,
      "description": "Curated file format version."
    },
    "groups": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "cidrs": {
            "description": "Network frame only: its IPv4 CIDR blocks, only when the Terraform or the engineer gave them.",
            "items": {
              "pattern": "^(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}/(3[0-2]|[12]?[0-9])$",
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "cloud": {
            "description": "The cloud a cloud, region, account, network or subnet frame belongs to, for example aws. Leave unset for plain groups.",
            "type": "string"
          },
          "column": {
            "maximum": 3,
            "minimum": 0,
            "type": "integer"
          },
          "evidence": {
            "items": {
              "$ref": "#/$defs/evidence"
            },
            "type": "array"
          },
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "cloud",
              "region",
              "account",
              "network",
              "subnet",
              null
            ]
          },
          "label": {
            "type": "string"
          },
          "parent": {
            "type": [
              "string",
              "null"
            ]
          },
          "shared_from": {
            "description": "Set by verify on a network frame that another stack creates: the stack it is read from. The frame title shows it; a curated value is dropped.",
            "type": "string"
          },
          "tier": {
            "description": "Subnet frame only: the tier of the subnets it stands for.",
            "enum": [
              "public",
              "private",
              "isolated"
            ]
          }
        },
        "required": [
          "id",
          "label",
          "kind",
          "parent",
          "column"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "inputs_sha256": {
      "description": "Source terraform only: the inputs key printed by cartographer extract and prompt, copied exactly.",
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "nodes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "attributes": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Attributes of that Terraform resource type that choose among its icons, for described nodes and managed-service externals.",
            "type": "object"
          },
          "group": {
            "type": [
              "string",
              "null"
            ]
          },
          "icon": {
            "description": "Qualified icon name such as aws:s3. Set only when the node's Terraform resources resolve to no icon (a non-cloud provider) or for a described node with no fitting tf_type. Find names with `cartographer icons`.",
            "pattern": "^[a-z]+:[a-z0-9_]+$",
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "multi": {
            "type": "boolean"
          },
          "tf": {
            "description": "Terraform resource addresses. At least one for source terraform, empty for source description.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "tf_type": {
            "description": "A Terraform resource type the catalog resolves the icon from, for described nodes and managed-service externals.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "label",
          "group",
          "tf",
          "multi"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "omitted": {
      "description": "Source terraform only: hints that are not drawn. Leave out for source description.",
      "items": {
        "additionalProperties": false,
        "properties": {
          "hint": {
            "description": "A hint id or value from facts.json hints that is not an external system",
            "type": "string"
          },
          "reason": {
            "maxLength": 80,
            "type": "string"
          }
        },
        "required": [
          "hint",
          "reason"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "source": {
      "description": "terraform: drawn from Terraform facts and code. description: drawn from what an engineer described, no facts file.",
      "enum": [
        "terraform",
        "description"
      ]
    },
    "system": {
      "description": "Display name of the system, for example GIP. The diagram title is derived from it.",
      "minLength": 1,
      "type": "string"
    },
    "view": {
      "enum": [
        "l7"
      ]
    }
  },
  "required": [
    "edges",
    "externals",
    "format",
    "groups",
    "nodes",
    "source",
    "system",
    "view"
  ],
  "title": "tfdiagram curated architecture",
  "type": "object"
}
